# ── Google Cloud / BigQuery ────────────────────────────────────────────────────
# Google Cloud project ID (required)
GCP_PROJECT_ID=your-gcp-project-id

# Path to your GCP service account JSON key file (required)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# BigQuery dataset and table names (optional, defaults shown)
BQ_DATASET_ID=stock_data
BQ_TABLE_ID=yahoo_prices

# Comma-separated list of stock tickers to track (optional, defaults shown)
STOCK_TICKERS=AAPL,MSFT,GOOGL,AMZN,TSLA

# Date range for historical data (optional, defaults: 1 year back → today)
START_DATE=2024-01-01
END_DATE=2025-01-01

# Data interval: 1d, 1wk, 1mo (optional, default: 1d)
DATA_INTERVAL=1d

# ── Forecast Agent ─────────────────────────────────────────────────────────────
# Anthropic API key — used by nlp2sql.py to convert natural language to SQL
# If not set, a pre-built query is used automatically (demo mode still works)
ANTHROPIC_API_KEY=your-anthropic-api-key

# BigQuery dataset/table for subscription data (forecast agent)
FORECAST_BQ_DATASET=subscription_data
FORECAST_BQ_TABLE=customer_metrics
